# Copy missing entries into .env; do not overwrite an existing OPENAI_API_KEY.
# Use unquoted KEY=value lines (also read as Spring properties).
DB_NAME=adwflow
DB_USERNAME=adwflow
DB_PORT=5432
# Generate a unique local password; do not commit real credentials.
DB_PASSWORD=
OPENAI_API_KEY=
ADWFLOW_MEDIA_ROOT=./data/generated-images
ADWFLOW_WORK_RETENTION=P30D

# scripts/redis.ps1 setup generates missing secrets without printing them.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_SSL_ENABLED=false
REDIS_KEY_PREFIX=adwflow:security
AUTH_HMAC_SECRET=
AUTH_VERIFICATION_TTL=PT3M
AUTH_RESET_TTL=PT15M
AUTH_RESEND_COOLDOWN=PT1M

# Enable after creating the n8n webhook workflow. Use HTTPS outside a private local network.
N8N_MAIL_ENABLED=false
N8N_MAIL_WEBHOOK_URL=
N8N_MAIL_AUTH_HEADER=X-AdwFlow-Webhook-Secret
N8N_MAIL_AUTH_SECRET=
APP_PUBLIC_BASE_URL=http://localhost:8080
N8N_MAIL_CONNECT_TIMEOUT=PT2S
N8N_MAIL_READ_TIMEOUT=PT8S
