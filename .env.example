# Copy missing entries into .env; do not overwrite an existing OPENAI_API_KEY.
# Use unquoted KEY=value lines (also read as Spring properties).
DB_NAME=adwflow
DB_USERNAME=adwflow
DB_PORT=5432
# Generate a unique local password; do not commit real credentials.
DB_PASSWORD=
OPENAI_API_KEY=
ADWFLOW_MEDIA_ROOT=./data/generated-images
ADWFLOW_WORK_RETENTION=P30D

# scripts/redis.ps1 setup generates missing secrets without printing them.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_SSL_ENABLED=false
REDIS_KEY_PREFIX=adwflow:security
AUTH_HMAC_SECRET=
AUTH_VERIFICATION_TTL=PT10M
AUTH_RESET_TTL=PT15M
AUTH_RESEND_COOLDOWN=PT1M
